{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuchi Labs MangaClean Atelier",
  "version": "0.1.0",
  "identifier": "com.yuchilabs.mangacleanatelier.tauri",
  "build": {
    "beforeDevCommand": { "script": "npm run build", "wait": true },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Yuchi Labs — MangaClean Atelier", "width": 1440, "height": 900, "minWidth": 940, "minHeight": 590, "create": false }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": { "active": false }
}
